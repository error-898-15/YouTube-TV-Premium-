<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tiktok_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F"
    android:orientation="vertical">

    <!-- Compact TV Remote Control Bar for TikTok feeds, videos, profiles, and comments -->
    <HorizontalScrollView
        android:id="@+id/tiktok_toolbar_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#141414"
        android:fillViewport="false"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tiktok_toolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tiktok_brand_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:text="TikTok"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_tiktok_foryou"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/tiktok_chip_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="For You"
                android:textColor="#F1F1F1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_tiktok_explore"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/tiktok_chip_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Explore"
                android:textColor="#F1F1F1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_tiktok_prev"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/tiktok_chip_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Prev"
                android:textColor="#F1F1F1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_tiktok_next"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/tiktok_chip_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Next"
                android:textColor="#F1F1F1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_tiktok_play_pause"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/tiktok_chip_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Play / Pause"
                android:textColor="#F1F1F1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_tiktok_comments"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/tiktok_chip_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Comments"
                android:textColor="#F1F1F1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_tiktok_profile"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/tiktok_chip_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Profile"
                android:textColor="#F1F1F1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_tiktok_cursor"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/tiktok_chip_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Cursor: OFF"
                android:textColor="#F1F1F1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_tiktok_back"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/tiktok_chip_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Back"
                android:textColor="#F1F1F1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_tiktok_reload"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/tiktok_chip_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Reload"
                android:textColor="#F1F1F1"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/tiktok_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@drawable/progress_bar_red"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/tiktok_web_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0F0F0F">

        <WebView
            android:id="@+id/tiktok_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <FrameLayout
            android:id="@+id/tiktok_fullscreen_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:visibility="gone" />

        <View
            android:id="@+id/tiktok_cursor_view"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
