<?xml version="1.0" encoding="utf-8"?>
<!-- Works for both states:
     - collapsed rail (72dp wide, clipped by parent): only the icon is visible, centered at x=36dp
     - expanded sidebar: icon + label inside a rounded pill (white when focused) -->
<androidx.leanback.widget.NonOverlappingLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:orientation="vertical">

    <!-- Group divider. IconHeaderItemPresenter.bindDivider() toggles it:
         LINE = VISIBLE, GAP = INVISIBLE (keeps space), NONE = GONE -->
    <View
        android:id="@+id/header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#33FFFFFF"
        android:visibility="gone" />

    <!-- duplicateParentState => the focus (set on the root view) still draws the white pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:paddingStart="11dp"
        android:paddingEnd="16dp"
        android:background="@drawable/header_pill_bg"
        android:duplicateParentState="true"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/header_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:duplicateParentState="true"
            android:contentDescription="@string/header_icon" />

        <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.HeaderMarqueeTextViewCompat
            android:id="@+id/header_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:duplicateParentState="true"
            android:textColor="@color/header_content_color"

            android:singleLine="true"
            android:maxWidth="150sp"
            android:marqueeRepeatLimit="marquee_forever"
            android:ellipsize="marquee"
            android:scrollHorizontally="true"

            style="@style/TextAppearance.Leanback.Header"/>
    </LinearLayout>
</androidx.leanback.widget.NonOverlappingLinearLayout>
