<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playback_fragment_root"
    android:transitionGroup="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F"
    tools:ignore="UnusedAttribute, RtlHardcoded">

    <!-- Frame container: normally fills the screen (no visual change). For Shorts it becomes the
         fixed-size rounded frame, so the AspectRatioFrameLayout inside can zoom/crop freely
         without changing the frame size (the container clips it). -->
    <FrameLayout
        android:id="@+id/shorts_video_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <com.google.android.exoplayer2.ui.AspectRatioFrameLayout
            android:id="@+id/surface_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center">
        </com.google.android.exoplayer2.ui.AspectRatioFrameLayout>
    </FrameLayout>

    <com.google.android.exoplayer2.ui.SubtitleView
        android:id="@+id/leanback_subtitles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="150sp"
        android:paddingRight="150sp"/>

    <!-- Shorts info/actions panel: placed right of the Shorts frame, bottom aligned (position/margins are
         finalised in ShortsOverlayHelper). Focus is blocked until the user presses RIGHT, so UP/DOWN
         always switch Shorts. -->
    <LinearLayout
        android:id="@+id/yt_shorts_overlay"
        android:layout_width="290dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_marginLeft="620dp"
        android:layout_marginBottom="44dp"
        android:descendantFocusability="blocksDescendants"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/shorts_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:id="@+id/shorts_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/shorts_channel_row"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <ImageView
                android:id="@+id/shorts_channel_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/action_channel"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/shorts_channel_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:maxWidth="240dp"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/shorts_btn_subscribe"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="19dp"
            android:background="@drawable/yt_shorts_btn_bg"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="16dp"
            android:text="+ Subscribe"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/shorts_btn_like"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/yt_shorts_btn_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="♡"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/shorts_btn_comment"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/yt_shorts_btn_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/action_chat"
                android:tint="#FFFFFF"
                tools:ignore="ContentDescription" />

            <ImageButton
                android:id="@+id/shorts_btn_autoscroll"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/yt_shorts_btn_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/action_mode_all"
                android:tint="#FFFFFF"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/shorts_btn_more"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/yt_shorts_btn_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="⋮"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/live_chat_wrapper"
        android:layout_width="300sp"
        android:layout_height="match_parent"
        android:layout_gravity="right">
        <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.chat.LiveChatView
            android:id="@+id/live_chat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:showIncomingTime="false"
            app:isMessageFocusable="false"
            app:incomingDefaultBubbleColor="@color/live_chat_bg"
            app:incomingTextColor="@color/white"
            app:incomingBubblePaddingLeft="10sp"
            app:incomingBubblePaddingRight="10sp"
            app:incomingBubblePaddingTop="0sp"
            app:incomingBubblePaddingBottom="0sp"
            app:incomingAvatarHeight="20dp"
            app:incomingAvatarWidth="20dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_overlay_wrapper"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:gravity="right"
        android:padding="10sp">
        <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.time.DateTimeView
            android:id="@+id/global_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:visibility="gone"
            android:textColor="@color/white"
            android:shadowColor="@color/black"
            android:shadowDx="1.5"
            android:shadowDy="1.3"
            android:shadowRadius="1.6"
            android:textStyle="bold"
            style="?attr/playbackControlsTimeStyle"/>
        <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.time.EndingTimeView
            android:id="@+id/global_ending_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:visibility="gone"
            android:textColor="@color/white"
            android:shadowColor="@color/black"
            android:shadowDx="1.5"
            android:shadowDy="1.3"
            android:shadowRadius="1.6"
            android:textStyle="bold"
            style="?attr/playbackControlsTimeStyle"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/debug_view_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="4sp"
        android:visibility="gone"
        android:layout_gravity="top|right"
        android:background="#70000000"/>

    <ViewStub
        android:id="@+id/youtube_overlay_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/youtube_overlay"/>

    <androidx.leanback.widget.NonOverlappingFrameLayout
        android:id="@+id/playback_fragment_background"
        android:transitionGroup="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <androidx.leanback.widget.NonOverlappingFrameLayout
        android:id="@+id/playback_controls_dock"
        android:transitionGroup="true"
        android:layout_height="match_parent"
        android:layout_width="match_parent"/>
</FrameLayout>
